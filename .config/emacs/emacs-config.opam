depends: [
  "ocaml" {>= "5.4.1" & < "5.5.0"}
  "dune" {>= "3.21.1" & < "4.0.0"}
  "ecaml" {= "dev"}
  "sexplib0" {>= "v0.17.0" & < "v0.18.0"}
  "async_kernel" {>= "v0.17.0" & < "v0.18.0"}
  "ocamlformat" {dev & = "0.28.1"}
]
pin-depends: [
  "ecaml.dev"
  "git+https://github.com/ilankri/ecaml#13590aee9fbda6605a63476aae52b223f6fcb31c"
]
